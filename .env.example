# Database
DB_PATH=./data/phantom.db
DB_ENCRYPTION_KEY=

# PHANTOM Core
CORE_HOST=127.0.0.1
CORE_PORT=9443
CORE_TLS_CERT=
CORE_TLS_KEY=

# PHANTOM Agent
AGENT_ID=
AGENT_HOST=
AGENT_PORT=9444
AGENT_CORE_HOST=127.0.0.1
AGENT_CORE_PORT=9443

# PHANTOM AI
AI_MODEL_PATH=./services/phantom-ai/models/
AI_MODEL_NAME=mistral-7b-q4.gguf
AI_PORT=8080
AI_GPU_LAYERS=0
AI_CONTEXT_SIZE=8192

# PHANTOM VPN
VPN_SUBNET=10.0.0.0/24
VPN_PORT=51820
VPN_PRIVATE_KEY=
VPN_PUBLIC_KEY=

# Network
NETWORK_SCAN_INTERVAL=300
NETWORK_SNAPSHOT_RETENTION=30

# Security
SESSION_TOKEN_ROTATION=true
CERT_ROTATION_DAYS=90

# Development
LOG_LEVEL=info
RUST_BACKTRACE=1