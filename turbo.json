{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_ROOT", "**/*.rs", "**/*.ts", "**/*.tsx"],
      "outputs": ["dist/**", "target/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_ROOT", "**/*.rs", "**/*.ts", "**/*.tsx", "**/*.test.*"]
    },
    "clean": {
      "cache": false
    }
  }
}