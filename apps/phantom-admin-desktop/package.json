{
  "name": "phantom-admin-desktop",
  "version": "1.0.0",
  "description": "PHANTOM Admin Desktop",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "Darkness X",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.0.0",
    "swr": "^2.0.0",
    "zustand": "^4.0.0",
    "qrcode.react": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8",
    "concurrently": "^8.0.0"
  },
  "build": {
    "appId": "com.darknessx.phantom-admin",
    "productName": "PHANTOM Admin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PHANTOM Admin",
      "artifactName": "PHANTOM-Admin-Setup-${version}.exe"
    }
  }
}